        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "testfixtures_run_status_total{status=\"FAILED\"}",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
