# Copy to terraform.tfvars and fill in sensitive values.
# Never commit terraform.tfvars to source control.

# Run `az account show --query id -o tsv` to get this.
subscription_id = "CHANGE_ME_your_azure_subscription_id"

location    = "eastus"
environment = "dev"
project     = "testfixtures"

# PostgreSQL
pg_admin_username = "pgadmin"
pg_admin_password = "CHANGE_ME_strong_password_1!"

# Redis (leave empty string to skip creating the secret)
redis_password = ""

# Kafka SASL (leave empty strings to skip creating the secrets)
kafka_username = ""
kafka_password = ""
