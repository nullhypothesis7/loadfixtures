# =============================================================================
# testfixtures — environment configuration
# =============================================================================
# Copy this file to .env and fill in your values before starting the stack.
# .env is gitignored. Never commit real credentials.
# =============================================================================

# --- Default database connection (fallback) ----------------------------------
DB_URL=jdbc:postgresql://localhost:5433/testdb
DB_USER=testuser
DB_PASSWORD=testpass

# --- Per-database URLs (prefix scan — add as many as needed) -----------------
# AppConfig scans for DB_URL_*, DB_USER_*, and DB_PASS_* at startup.
# Each suffix becomes a named database target in the tool.
#
# These passwords must match the POSTGRES_PASSWORD hardcoded for each
# postgres-* service in docker-compose.yml — the containers do NOT read
# their own credentials from this file, so if you change a password here
# without also changing it in docker-compose.yml, schema/load will fail
# with "password authentication failed" for that database.

DB_URL_TESTDB=jdbc:postgresql://localhost:5433/testdb
DB_USER_TESTDB=testuser
DB_PASS_TESTDB=testpass

DB_URL_BANKING=jdbc:postgresql://localhost:5434/bankingdb
DB_USER_BANKING=bankinguser
DB_PASS_BANKING=bankingpass

DB_URL_BANKSCHEMA=jdbc:postgresql://localhost:5436/bankschemadb
DB_USER_BANKSCHEMA=bankschemauser
DB_PASS_BANKSCHEMA=bankschemapass

DB_URL_HEALTHCARE=jdbc:postgresql://localhost:5435/healthcaredb
DB_USER_HEALTHCARE=healthcareuser
DB_PASS_HEALTHCARE=healthcarepass

DB_URL_SALESFORCE=jdbc:postgresql://localhost:5437/salesforcedb
DB_USER_SALESFORCE=salesforceuser
DB_PASS_SALESFORCE=salesforcepass

DB_URL_SALESFORCEENTERPRISE=jdbc:postgresql://localhost:5438/salesforceenterprisedb
DB_USER_SALESFORCEENTERPRISE=salesforceentuser
DB_PASS_SALESFORCEENTERPRISE=salesforceentpass

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Output directories ------------------------------------------------------
PIPES_DIR=./pipes
CSV_OUTPUT_DIR=./csv-output
PARQUET_OUTPUT_DIR=./parquet-output

# --- Worker pool -------------------------------------------------------------
WORKER_POOL_SIZE=4
